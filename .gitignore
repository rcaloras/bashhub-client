# Virtual Environment
.venv/

# Compiled python modules.
*.pyc

# Swap files
.*.swp

# Exports for dev mode which should be for local development only
dev-exports.sh

# Setuptools distribution folder.
/dist/

# Python egg metadata, regenerated from source files by setuptools.
/*.egg-info
/*.egg

# Generated by setuptools-scm for built distributions.
/bashhub/_version.py

.vscode/
/build/
